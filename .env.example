# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# MongoDB Atlas — https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agentic-ai-notebook

# Optional — push chapter ticks to the Engineering Profile Notion table
# 1. https://www.notion.so/my-integrations → New internal integration
# 2. Share the AI Roadmap database with that integration
# 3. Paste the token here and on Netlify. Only this email's progress is written.
NOTION_TOKEN=
NOTION_SYNC_EMAIL=you@example.com
